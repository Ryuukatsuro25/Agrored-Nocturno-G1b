    {
      "name": "1 · CRUD completo (casos 1 a 13)",
      "description": "Casos de la Parte 2 del taller.",
      "item": [
        {
          "name": "1. Listar todos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "pm.test('Responde un arreglo', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/clientes",
            "description": "Esperado: 200 con un arreglo."
          }
        },
        {
          "name": "2. Filtrar por tipo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "pm.test('Responde un arreglo', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "pm.test('Todos cumplen el filtro', () => pm.response.json().forEach(r => pm.expect(r.tipo).to.eql('comercio')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/clientes?tipo=comercio",
            "description": "Filtro por atributo. Esperado: 200, todos con tipo = comercio."
          }
        },
        {
          "name": "3. Consultar por lotes ?ids=1,2",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "pm.test('Trae solo los ids pedidos', () => pm.expect(pm.response.json().map(r => r.id)).to.eql([1, 2]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/clientes?ids=1,2",
            "description": "Lo usa ms-pedidos para componer. Esperado: 200 con exactamente los registros 1 y 2."
          }
        },
        {
          "name": "4. Obtener un registro existente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "pm.test('Es el 1', () => pm.expect(pm.response.json().id).to.eql(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/clientes/1",
            "description": "Esperado: 200."
          }
        },
        {
          "name": "5. Obtener un id que no existe",
