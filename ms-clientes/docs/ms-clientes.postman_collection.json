                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/clientes/abc",
            "description": "Esperado: 400."
          }
        },
        {
          "name": "7. Crear con datos válidos",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('nit_nuevo', String(900000000 + Math.floor(Math.random() * 99999999)) + '-' + Math.floor(Math.random() * 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 201', () => pm.response.to.have.status(201));",
                  "pm.test('Cabecera Location', () => pm.response.to.have.header('Location'));",
                  "if (pm.response.code === 201) pm.collectionVariables.set('idCreado', pm.response.json().id);",
                  "if (pm.response.code === 201) pm.collectionVariables.set('nit_creado', pm.response.json().nit);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/clientes",
            "description": "Esperado: 201 + cabecera Location. Guarda el id en idCreado.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Frutas del Pacífico\",\n  \"nit\": \"{{nit_nuevo}}\",\n  \"ciudad\": \"Buenaventura\",\n  \"telefono\": \"3154442211\",\n  \"tipo\": \"distribuidor\"\n}",
              "options": {
